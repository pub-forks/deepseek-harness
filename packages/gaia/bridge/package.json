{
  "name": "@deepseek-ai/dsh-gaia-bridge",
  "description": "Loopback host control API for Gaia",
  "version": "0.1.7-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
